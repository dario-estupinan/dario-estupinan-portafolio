---
import { usarTextos } from '../i18n/textos.js';
const t = usarTextos(Astro.props.lang).bienvenida;
---
<!-- Solo se muestra si /bienvenida-pre.js marcó <html data-bienvenida>: primera visita de la sesión, con JavaScript y sin «movimiento reducido». -->
<div class="bienvenida" data-bienvenida data-color="tinta" role="status">
  <canvas aria-hidden="true"></canvas>
  <ol role="list">
    {t.pasos.map(paso => <li><span class="caja" aria-hidden="true"></span>{paso}</li>)}
  </ol>
  <p class="rotulo">{t.saltar}</p>
</div>

<script>
  import '../scripts/bienvenida.js';
</script>

<style>
  .bienvenida { display: none; }
  :global(html[data-bienvenida]) .bienvenida {
    display: grid; place-content: end end; gap: 1.2rem; position: fixed; inset: 0; z-index: 50; padding: var(--borde-pagina);
    background: var(--fondo); color: var(--texto); cursor: pointer;
    /* Respaldo: aunque el script no llegue a ejecutarse, la capa se retira sola. */
    animation: fuera .5s 2s forwards cubic-bezier(.7, 0, .3, 1);
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--texto); }
  ol, p { position: relative; }
  ol { display: grid; gap: .7rem; font-family: var(--f-mono); font-size: clamp(.8rem, .7rem + .5vw, 1rem); }
  li { display: flex; align-items: center; gap: .8rem; opacity: .35; animation: marca .01s forwards; animation-delay: calc(var(--i, 0) * .3s + .15s); }
  .caja { width: .9em; height: .9em; border: 1.5px solid; flex: none; animation: llena .01s forwards; animation-delay: calc(var(--i, 0) * .3s + .15s); }
  li:nth-child(2), li:nth-child(2) .caja { --i: 1; } li:nth-child(3), li:nth-child(3) .caja { --i: 2; } li:nth-child(4), li:nth-child(4) .caja { --i: 3; }
  p { opacity: .7; }
  @keyframes marca { to { opacity: 1; } }
  @keyframes llena { to { background: var(--acento); border-color: var(--acento); } }
  /* El iris se cierra sobre el punto por el que se fue el fénix (FUGA en scripts/fenix.js). */
  @keyframes fuera { from { clip-path: circle(150% at 74% 26%); } to { clip-path: circle(0 at 74% 26%); visibility: hidden; } }
</style>
