---
import Mascota from './Mascota.astro';
import Cinta from './Cinta.astro';
import { usarTextos } from '../i18n/textos.js';
import { enlaceWhatsApp } from '../lib/contacto.js';
const { lang, capturas } = Astro.props;
const todo = usarTextos(lang), t = todo.portada;
---
<section id="portada" class="portada" data-color="cobalto">
  <div class="centro">
    <div class="texto">
      <p class="rotulo ficha">{t.ficha.map(f => <span>{f}</span>)}</p>
      <h1>{t.h1.antes} <em>{t.h1.a}</em>, <em>{t.h1.b}</em> {t.h1.y} <em>{t.h1.c}</em>.</h1>
      <div class="bajo">
        <p>{t.parrafo}</p>
        <a class="boton" data-principal href={enlaceWhatsApp(todo.sitio.whatsapp)} rel="noopener">{t.boton} <span aria-hidden="true">→</span></a>
      </div>
      <ol class="serv" role="list">
        {t.lista.map(([nombre, detalle], i) => <li><span class="rotulo">0{i + 1}</span><b>{nombre}</b><span>{detalle}</span></li>)}
      </ol>
    </div>
    <div class="escena" data-color="lima"><Mascota lang={lang} /></div>
  </div>
  <Cinta lang={lang} palabras={t.cinta} capturas={capturas} color="coral" />
</section>

<style>
  .portada { background: var(--fondo); color: var(--texto); min-height: calc(100svh - var(--alto-nav)); display: grid; grid-template-rows: 1fr auto; }
  .centro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1rem, 3vw, 3rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.5rem) var(--borde-pagina); }
  h1 { font-size: var(--t-titular); line-height: 1.02; letter-spacing: -.03em; font-weight: 800; font-stretch: 85%; text-wrap: balance; }
  h1 em { font-style: normal; background: var(--lima); color: var(--tinta); border-radius: .18em; padding: .04em .18em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  h1 em:nth-of-type(2) { background: var(--lila); }
  h1 em:nth-of-type(3) { background: var(--coral); }
  /* Bloque de color de la mascota: se monta sobre la cinta que corre debajo. */
  .escena { background: var(--fondo); color: var(--texto); align-self: end; position: relative; z-index: 1; padding: 1.2rem 1.2rem 1.6rem; border-radius: var(--radio) var(--radio) 0 0; margin-bottom: -5rem; }
  .bajo { display: grid; grid-template-columns: minmax(0, 36ch) auto; gap: 1.5rem 2.5rem; align-items: end; margin-top: 1.8rem; }
  .bajo .boton { justify-self: start; }
  .serv { margin-top: 2rem; border-top: 1.5px solid; max-width: 36rem; }
  .serv li { display: flex; flex-wrap: wrap; align-items: baseline; gap: .1rem 1rem; padding: .55rem 0; border-bottom: 1.5px solid; }
  .serv b { font-weight: 800; margin-right: auto; }
  @media (max-width: 61.99rem) {
    .centro { grid-template-columns: minmax(0, 1fr); }
    .escena { order: -1; max-width: 28rem; width: 100%; margin: 0 auto; border-radius: var(--radio); }
    .bajo { grid-template-columns: minmax(0, 1fr); }
  }
</style>
